         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Dataset for estimation of obesity levels based on eating habits and physical condition in individuals from Colombia, Peru and Mexico</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
